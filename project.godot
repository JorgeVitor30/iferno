; Engine configuration file.
config_version=5

[application]
config/name="Iferno"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GlobalInput="*res://scripts/global_input.gd"
PixelFont="*res://scripts/pixel_font.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68)]}
move_up={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87)]}
move_down={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83)]}
dodge={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":2)]}
debug_hit={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":72)]}
toggle_fullscreen={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194342), Object(InputEventKey,"alt_pressed":true,"physical_keycode":4194309)]}
inventory={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194306)]}
shoot={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":1)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
